# Supabase Edge Functions provides SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY at runtime. Never expose the service role to the browser.

# Pilot kill switch. Keep false until the migration, OAuth consent, label and Pub/Sub are ready.
BANK_EMAIL_INTEGRATION_ENABLED=false
BANK_EMAIL_PILOT_HOTEL_NAME="Hotel Marena San Isidro"

# Gmail-only OAuth client. These values keep the Calendar OAuth client isolated.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=

# Existing shared Google OAuth client used by Calendar. Gmail only falls back
# to these legacy names when the GMAIL_OAUTH_* values are absent.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Gmail API / Pub/Sub
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_VERIFICATION_AUDIENCE=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GMAIL_PAYMENT_LABEL="PAGOS HOTEL MARENA"

# Use a randomly generated value of at least 32 characters. Do not reuse CRON_SECRET.
BANK_TOKEN_ENCRYPTION_KEY=
CRON_SECRET=

# Optional safety limits and matching behavior
BANK_EMAIL_MIN_AMOUNT_COP=1000
BANK_EMAIL_MAX_AMOUNT_COP=50000000
BANK_EMAIL_MATCH_WINDOW_MINUTES=30
BANK_EMAIL_RULES_JSON=
BANK_EMAIL_ALLOWED_ORIGINS=https://gestiondehotel.com,https://www.gestiondehotel.com,http://127.0.0.1:5500,http://localhost:5500

# Existing application URL used for the OAuth callback redirect.
SITE_URL=https://gestiondehotel.com/
